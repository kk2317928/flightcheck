NODE_ENV=development
TZ=Asia/Macau
WEB_PORT=3000
WORKER_HEARTBEAT_INTERVAL_MS=60000
DATABASE_URL=postgresql://flightcheck:flightcheck@localhost:5432/flightcheck
POSTGRES_DB=flightcheck
POSTGRES_USER=flightcheck
POSTGRES_PASSWORD=change-this-before-deployment
RUN_SEED=true
FLIGHTCHECK_IMAGE_TAG=latest
TRUST_PROXY_HEADERS=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-at-least-12-characters
